{
  "name": "surf-spa-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "concurrently \"npm run dev\" \"npx json-server --watch public/backend/db.json --port 3001\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "lint:ts": "eslint . --ext ts,tsx --max-warnings 0",
    "lint:ts:fix": "eslint . --ext ts,tsx --max-warnings 0 --fix",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint:scss:fix": "stylelint \"**/*.scss\" --fix",
    "check:ts": "tsc --extendedDiagnostics",
    "prepare": "husky install && npx husky set .husky/pre-commit \"npx lint-staged\" && npx husky set .husky/pre-push \"npm run check:ts\"",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-pwa-asset": "pwa-asset-generator public/logo.svg public -i ./index.html --icon-only"
  },
  "lint-staged": {
    "!(*min).{css,scss}": [
      "stylelint --fix"
    ],
    "!(*min).{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@chatscope/chat-ui-kit-react": "^2.0.3",
    "@reduxjs/toolkit": "^2.3.0",
    "@types/react-select": "^5.0.1",
    "axios": "^1.7.7",
    "chart.js": "^4.4.6",
    "classnames": "^2.5.1",
    "json-server": "^1.0.0-beta.3",
    "mobile-detect": "^1.4.5",
    "moment": "^2.30.1",
    "pwa-asset-generator": "^6.4.0",
    "qr-scanner": "^1.4.2",
    "rc-progress": "^4.0.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-insta-stories": "^2.7.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.1",
    "react-select": "^5.8.3",
    "react-toastify": "^10.0.6",
    "redux-persist": "^6.0.0",
    "swiper": "^11.1.14",
    "vite-plugin-svgr": "^4.3.0",
    "workbox-background-sync": "^7.3.0",
    "workbox-build": "^7.3.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-sw": "^7.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@types/cypress": "^0.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/serviceworker": "^0.0.107",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.6.0",
    "concurrently": "^9.1.0",
    "cypress": "^13.17.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-next": "14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^0.6.15",
    "husky": "^8.0.3",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "sass": "^1.69.5",
    "storybook": "^7.6.6",
    "stylelint": "^16.1.0",
    "stylelint-config-standard-scss": "^12.0.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^1.6.0",
    "workbox-window": "^7.3.0"
  }
}
